{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@royalcat/opencode-dcp-rc",
    "version": "4.0.2",
    "type": "module",
    "workspaces": [
        "tests/logger"
    ],
    "description": "OpenCode DCP fork: hidden context compression with a selection-only compress tool (Sleev-style)",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tui": {
            "types": "./dist/tui.d.ts",
            "import": "./tui.tsx"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "npm run clean && tsup && tsc --emitDeclarationOnly",
        "verify:package": "node scripts/verify-package.mjs",
        "check:package": "npm run build && npm run verify:package",
        "prepublishOnly": "npm run check:package",
        "dev": "opencode plugin dev",
        "typecheck": "tsc --noEmit && npm run typecheck --workspace=tests/logger",
        "test": "node --import tsx --test tests/*.test.ts && npm test --workspace=tests/logger",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dcp": "tsx scripts/print.ts",
        "lab:rc": "node scripts/lab-rc.mjs"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "context",
        "pruning",
        "optimization",
        "tokens"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/royalcat/opencode-dcp-rc.git"
    },
    "bugs": {
        "url": "https://github.com/royalcat/opencode-dcp-rc/issues"
    },
    "homepage": "https://github.com/royalcat/opencode-dcp-rc#readme",
    "author": "royalcat",
    "license": "AGPL-3.0-or-later",
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.18.29"
    },
    "dependencies": {
        "@anthropic-ai/tokenizer": "^0.0.4",
        "@opencode-ai/sdk": "^1.4.3",
        "@opentui/core": "^0.5.14",
        "@opentui/solid": "^0.5.14",
        "jsonc-parser": "^3.3.1",
        "solid-js": "^1.9.12"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "^1.18.34",
        "@opencode/plugin": "^2.0.22",
        "@opencode/theme": "^2.0.4",
        "@types/node": "^25.5.0",
        "prettier": "^3.8.1",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    },
    "overrides": {
        "@babel/core": "7.29.7",
        "esbuild": "0.28.1"
    },
    "files": [
        "dist/",
        "lib/",
        "server.js",
        "tui.tsx",
        "README.md",
        "LICENSE"
    ]
}
